# ============================================================================
# Zeta configuration.  Copy to `.env` (project root) and edit.  Never commit .env.
# Every value has a sensible default; the minimal local setup needs nothing but
# a running Ollama or LM Studio.
# ============================================================================

# ---- Mode -------------------------------------------------------------------
ZETA_MODE=local                 # local | cloud
ZETA_NAME=Zeta
HOST=127.0.0.1
PORT=8765
DEBUG=false
LOG_LEVEL=INFO
# API_TOKEN=                    # required if HOST is not localhost (cloud mode)

# ---- LLM --------------------------------------------------------------------
LLM_PROVIDER=ollama             # ollama | lmstudio | openai | openrouter | openai_compatible | anthropic | mock
LLM_MODEL=qwen3:8b              # e.g. qwen3:8b, llama3.1, qwen2.5:14b, gpt-4o-mini, claude-sonnet-5
# LLM_BASE_URL=                 # override provider URL (required for openai_compatible)
# LLM_API_KEY=                  # key for openai_compatible providers
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=180
LLM_CONTEXT_LENGTH=16384        # Ollama num_ctx. Must be > 4096 or the tool definitions get truncated.
LLM_THINK=false                 # qwen3 / deepseek-r1 "thinking" mode: slower, sometimes better plans
LLM_STREAM=true                 # stream reply text to the UI as it is generated
LLM_SUPPORTS_TOOLS=true         # false -> JSON-in-text tool protocol for models without tool calling
# LLM_VISION_MODEL=llava        # optional vision model for analyze_screen (ollama pull llava)
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=           # LLM_PROVIDER=openrouter, LLM_MODEL=openai/gpt-4o-mini (or google/gemini-2.5-flash, ...:free)
# ANTHROPIC_API_KEY=
# EMBEDDING_PROVIDER=ollama     # optional: semantic memory/file search (ollama | openai | openai_compatible)
# EMBEDDING_MODEL=nomic-embed-text   # ollama pull nomic-embed-text

# ---- Agent ------------------------------------------------------------------
AGENT_MAX_STEPS=25
AGENT_HISTORY_MESSAGES=30
CONFIRMATION_TIMEOUT_SECONDS=300
TOOL_TIMEOUT_SECONDS=120

# ---- Voice ------------------------------------------------------------------
STT_PROVIDER=whisper            # disabled | whisper (faster-whisper, local, free) | elevenlabs (Scribe, uses ELEVENLABS_API_KEY) | openai
STT_MODEL=base                  # faster-whisper size: tiny | base | small | medium | large-v3
# STT_LANGUAGE=                 # pin one language for everything; empty = choose per utterance
# STT_LANGUAGES=en,hi           # narrow that choice to the languages actually spoken; empty = all 99
STT_DEVICE=auto                 # auto | cpu | cuda.  For GPU (12x faster): pip install nvidia-cublas-cu12 nvidia-cudnn-cu12
# STT_BASE_URL=
# STT_API_KEY=
TTS_PROVIDER=chatterbox         # chatterbox (local GPU, cloneable voice) | local (Windows voices) | piper | elevenlabs | disabled
# VOICE_PROVIDER=local          # alias for TTS_PROVIDER
# TTS_VOICE=                    # Windows voice name / ElevenLabs voice id / piper .onnx path
TTS_RATE=0
# ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2   # eleven_flash_v2_5 = fastest; eleven_v3 = performs [laughs]/[sighs] tags (slower)
PIPER_EXECUTABLE=piper
WAKE_WORD_ENABLED=false         # hands-free "Hey Zeta": pip install sounddevice numpy (uses faster-whisper tiny on CPU)
WAKE_WORD=hey zeta
WAKE_WORD_ENGINE=auto           # auto | whisper | openwakeword (pip install openwakeword; WAKE_WORD_MODEL=hey_jarvis or a custom .onnx)
# WAKE_WORD_MODEL=
# WAKE_WORD_DEVICE=             # microphone name or index (see GET /api/voice/wake); empty = default

# ---- Chatterbox: Zeta's own voice, running on your GPU -----------------------
# Install once with install_tts.bat (separate .venv-tts: PyTorch + CUDA, ~3 GB).
# The voice server starts by itself the first time Zeta speaks.
CHATTERBOX_MODEL=turbo          # turbo (fast, English) | base | multilingual (23 languages, incl. Hindi)
# CHATTERBOX_LANGUAGE=          # multilingual only; empty = detect from the reply (Devanagari -> Hindi)
# A second voice for non-English replies, so English keeps turbo's speed. Empty = off.
# CHATTERBOX_NON_ENGLISH_MODEL=multilingual
# CHATTERBOX_NON_ENGLISH_URL=http://127.0.0.1:8767
CHATTERBOX_DEVICE=auto          # auto | cuda | cpu.  Falls back to CPU if the GPU is full (Ollama holds VRAM)
# Reference clip for the voice. Empty = the built-in voice, which is female.
# Point it at voice/your_clip.wav (7-15 seconds, one speaker) to use a different voice.
CHATTERBOX_VOICE=
CHATTERBOX_BASE_URL=http://127.0.0.1:8766
CHATTERBOX_AUTOSTART=true       # start the voice server automatically when it is needed
# CHATTERBOX_EXAGGERATION=0.5   # neutral 0.5; higher = more emotional acting
# CHATTERBOX_CFG_WEIGHT=0.5     # lower = slower, more deliberate pacing

# ---- Emotional intelligence --------------------------------------------------
# Zeta reads how you seem (words + tone of voice) and adapts how it answers.
# Nothing leaves your machine: the analysis is local, and only a one-line hint is
# added to the prompt. Readings are stored in the `emotion_log` table.
EMOTION_ENABLED=true
EMOTION_PROSODY=true            # also analyse tone of voice on spoken turns (needs faster-whisper's PyAV decoder)
EMOTION_ADAPT_VOICE=true        # adapt the spoken delivery to how you sound
EMOTION_REGION=in               # which crisis helplines to offer if someone is in real distress: in | us | uk | intl
EMOTION_SUPPORT_MODE=true       # allow support to take priority over task efficiency when someone is struggling

# ---- Filesystem -------------------------------------------------------------
# Semicolon-separated folders Zeta may read/write.  Default: your home folder.
# FS_ALLOWED_ROOTS=C:\Users\you;D:\Projects      # or whole drives: C:\;D:\ (system folders stay write-protected)
# FS_INDEX_ROOTS=C:\Users\you\Documents;D:\Projects
FS_INDEX_ON_STARTUP=true
FS_INDEX_CONTENT=true
FS_INDEX_CONTENT_MAX_BYTES=2000000

# ---- Terminal ---------------------------------------------------------------
TERMINAL_SHELL=powershell       # powershell | cmd | bash
TERMINAL_TIMEOUT_SECONDS=120
# TERMINAL_CWD=D:\Projects

# ---- Browser ----------------------------------------------------------------
BROWSER_HEADLESS=false
BROWSER_SEARCH_ENGINE=duckduckgo
# BROWSER_DOWNLOAD_DIR=

# ---- WhatsApp ---------------------------------------------------------------
WHATSAPP_PROVIDER=              # web (free, scan QR once) | business (Meta Cloud API) | wapi (gateway)  (empty = disabled)
WHATSAPP_CONFIRM_SEND=true
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_BUSINESS_PHONE_ID=
# WAPI_BASE_URL=
# WAPI_TOKEN=
# WAPI_INSTANCE_ID=
# CONTACTS_FILE=backend/config/contacts.json

# ---- Email ------------------------------------------------------------------
EMAIL_PROVIDER=                 # gmail | outlook | imap  (empty = disabled)
EMAIL_AUTH=password             # password (App Password) | oauth (Gmail/Outlook sign-in, see docs/INTEGRATIONS.md)
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=               # App Password (only for EMAIL_AUTH=password)
# EMAIL_IMAP_HOST=              # only for EMAIL_PROVIDER=imap
# EMAIL_SMTP_HOST=
EMAIL_CONFIRM_SEND=true
# OAuth clients (free): Google Cloud Console -> OAuth client (Desktop app); Microsoft Entra -> App registration
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=common

# ---- Developer --------------------------------------------------------------
# GITHUB_TOKEN=

# ---- Cloud (optional, all off by default) -----------------------------------
AWS_ENABLED=false
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# ---- Database ---------------------------------------------------------------
# Default: local SQLite at data/zeta.db (conversations, tasks, memory, audit log, schedules).
# Optional PostgreSQL / Supabase (pip install asyncpg). Supabase: Project Settings -> Database ->
# Connection string (URI). Prefer the "Transaction" pooler (port 6543); SSL is applied automatically.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The file search index (data/file_index.db, FTS5) always stays local: it mirrors this computer's disk.

# ---- Secrets ----------------------------------------------------------------
SECRET_STORE=env                # env | keyring (Windows Credential Manager via `pip install keyring`)
